@@ -16,30 +16,33 @@ function clamp(n: number, min = 0, max = 100): number {
   return Math.max(min, Math.min(max, n));
 }
 
+// Continuous falloff instead of hard buckets, so a site whose real response
+// time hovers near a boundary (e.g. 780ms vs 820ms) doesn't swing a chunk of
+// points from one test to the next on nothing but ordinary network jitter.
+// goodMs still earns full marks; badMs is where it bottoms out at the floor.
+function scoreWithFalloff(value: number, goodMs: number, badMs: number, maxPoints: number, floorPoints: number): number {
+  if (value <= goodMs) return maxPoints;
+  if (value >= badMs) return floorPoints;
+  const t = (value - goodMs) / (badMs - goodMs);
+  return Math.round(maxPoints - t * (maxPoints - floorPoints));
+}
